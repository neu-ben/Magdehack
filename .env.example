# Supabase (Projekt "Hackathon")
SUPABASE_URL=https://isjiaofflwtnampxeifq.supabase.co
# Secret Key: Supabase Dashboard -> Project Settings -> API Keys -> "Secret keys" (beginnt mit sb_secret_)
# Nur serverseitig verwenden, niemals mit NEXT_PUBLIC_ versehen.
SUPABASE_SECRET_KEY=

# Anthropic API Key: https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# Modell der Übergabe-Auswertung (Sonnet: ca. 16 s, Opus: ca. 40 s für 2 Patienten)
CLAUDE_MODEL=claude-sonnet-5-5

# Modell für den Otti-Chat (optional, Standard: claude-opus-5-5)
CLAUDE_OTTI_MODEL=claude-opus-5-5
