SUPABASE_SECRET_KEY=

# Anthropic API Key: https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# Modell des Agenten (austauschbar, z. B. claude-sonnet-5-5 wenn es zu langsam ist)
CLAUDE_MODEL=claude-opus-5-5
